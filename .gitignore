node_modules/
dist/
# Screenshots written by scripts/gamepadHarness.mjs
artifacts/
# ~200 PNGs per sweep, written by `npm run audit:circuits`. Regenerate rather
# than commit: they are evidence about a build, not part of one.
audit-out/
cockpit-out/
# ~30 PNGs per run, written by `npm run shoot:hud`. Same reasoning.
hud-out/
.DS_Store
*.local
.vite/
node_modules

# Agent worktrees.
.claude/

# Frames extracted from the user's own gameplay recordings, used as the visual
# reference target. Derived data and ~105MB of JPEG — kept on disk, out of git.
# Regenerate with:
#   ffmpeg -i <recording>.MP4 -vf "fps=2,scale=1280:-1" -q:v 3 reference/<name>/f_%04d.jpg
reference/

# Screenshots and JSON written by scripts/probeSharpness.ts and
# scripts/probeRenderPerf.ts. Evidence about a build, not part of one.
sharp-out/
grain-out/
perf-out/
weather-out/
.probe/

# Same reasoning as cockpit-out: the phone-tier run of the same probe.
cockpit-out-low/

# Symlinks an agent worktree makes to the main checkout.
/reference
/node_modules

# Fetched CC0/OFL assets — regenerate with `npx tsx scripts/fetchAssets.ts`
public/assets/
public/brand/

# Side-by-side comparisons written by `npm run probe:grade`. Evidence, not build.
grade-out/

# Agent scratch: parameter sweeps and one-off fits. Never part of a build.
scratch/

# The symlink an agent worktree makes to the main checkout.
/public/assets
